<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         VUE LISTE (list)
         Affiche les enregistrements sous forme de tableau.
         En Odoo 17+, on écrit <list> (avant c'était <tree>).
         ============================================================ -->
    <record id="view_hello_record_list" model="ir.ui.view">
        <field name="name">hello.record.list</field>
        <field name="model">hello.record</field>
        <field name="arch" type="xml">
            <list string="Hello Records">
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         VUE FORMULAIRE (form)
         Affiche un enregistrement pour l'éditer.
         ============================================================ -->
    <record id="view_hello_record_form" model="ir.ui.view">
        <field name="name">hello.record.form</field>
        <field name="model">hello.record</field>
        <field name="arch" type="xml">
            <form string="Hello Record">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         VUE RECHERCHE (search)
         Barre de recherche + filtres + regroupements.
         ============================================================ -->
    <record id="view_hello_record_search" model="ir.ui.view">
        <field name="name">hello.record.search</field>
        <field name="model">hello.record</field>
        <field name="arch" type="xml">
            <search string="Rechercher un Hello">
                <field name="name"/>
                <field name="description"/>
                <filter name="filter_active"
                        string="Actifs"
                        domain="[('active', '=', True)]"/>
                <group expand="0" string="Grouper par">
                    <filter name="group_by_active"
                            string="Actif"
                            context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================
         ACTION
         Lie les vues ci-dessus à une action appelable (par un menu).
         ============================================================ -->
    <record id="action_hello_record" model="ir.actions.act_window">
        <field name="name">Hello Records</field>
        <field name="res_model">hello.record</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre premier Hello Record !
            </p>
        </field>
    </record>

</odoo>